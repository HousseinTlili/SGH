{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Message envelope shared by every event (exchange sgh.events, routing key = type)",
  "type": "object",
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "appointment.created",
        "appointment.cancelled",
        "lab.request.created",
        "lab.result.ready",
        "prescription.created",
        "prescription.dispensed"
      ]
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  }
}
