{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lab.request.created.data.schema.json",
  "title": "lab.request.created data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "labRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "consultationId": {
      "type": "string",
      "format": "uuid"
    },
    "patientId": {
      "type": "string",
      "format": "uuid"
    },
    "doctorId": {
      "type": "string",
      "format": "uuid"
    },
    "priority": {
      "enum": [
        "ROUTINE",
        "URGENT"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 10
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    }
  },
  "required": [
    "labRequestId",
    "consultationId",
    "patientId",
    "doctorId",
    "priority",
    "tests"
  ]
}
